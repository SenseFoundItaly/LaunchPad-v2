# LLM API Keys — at least one of ANTHROPIC_API_KEY or OPENROUTER_API_KEY
# is required. The router in src/lib/llm/router.ts auto-selects:
#   - OPENROUTER_API_KEY set → all LLM calls route via OpenRouter gateway
#     (single invoice, access to Gemini/DeepSeek/free tiers, ~5% markup,
#     +50-100ms hop). Tier models use OpenRouter slugs (anthropic/claude-*).
#     NOTE: this key also gates CHAT_CACHE_SPLIT (see below) — the chat
#     prompt-cache breakpoint only ships on the patched OpenRouter path.
#   - Otherwise → direct Anthropic via ANTHROPIC_API_KEY.
# OpenAI is optional fallback for the legacy chat() client path only.
OPENAI_API_KEY=your_openai_key
OPENAI_MODEL=gpt-4o
ANTHROPIC_API_KEY=your_anthropic_key
# Optional override. Leave UNSET to follow the router's balanced tier — the
# code default now derives from MODEL_CONFIG. (Never pin a dated snapshot
# here: the old claude-sonnet-4-20250514 default outlived the model and 404s.)
# ANTHROPIC_MODEL=
OPENROUTER_API_KEY=sk-or-v1-your_openrouter_key

# Pi Agent SDK — provider + model selection for runAgent()/runAgentStream()
# When a route passes a `task` label to runAgent(), the router in
# src/lib/llm/router.ts picks the tier automatically and these env vars are
# ignored. They remain as a fallback for call sites that haven't been
# retrofitted yet.
# PI_PROVIDER=anthropic        # anthropic | openai
# PI_MODEL=                    # unset → MODEL_CONFIG's balanced tier

# Task-complexity routing override — optional JSON mapping of task → tier.
# Overrides the defaults in src/lib/llm/router.ts. Useful to temporarily
# force "chat" to premium for user testing, or "monitor-agent" to cheap to
# slash cost after Forge-scale ramp. Tiers: cheap | balanced | premium.
# LLM_ROUTING_JSON={"chat":"premium","monitor-agent":"cheap"}

# Pi Agent prompt caching — ephemeral cache TTL on the Anthropic system prompt
# and last-user-message. Pi AI defaults to "short" (5 min TTL). "long" (1 h TTL)
# is worth it for the Monday cron run where 4 ecosystem monitors execute
# back-to-back against the same stable SOUL+AGENTS+HEARTBEAT prefix.
# CAVEAT: this setting is a NO-OP on the OpenRouter path — pi-ai only emits
# ttl:"1h" when the baseUrl is api.anthropic.com. It applies only when running
# direct-Anthropic. (1h writes also bill at 2x base input vs 1.25x for 5min,
# which the cost meter does not model — weigh that before assuming it's free.)
# Confirm caching is working via `llm_usage_logs.cache_read_tokens > 0`.
PI_CACHE_RETENTION=long

# Chat prompt-cache breakpoint — ON by default; set to 0 to disable.
# Marks the static/volatile boundary of the chat system prompt so the ~21k-token
# stable half (SOUL + AGENTS + ARTIFACT_INSTRUCTIONS + JOURNEY_RULES) bills as a
# cache READ (0.1x) instead of being rewritten every turn. Measured live:
# $0.150 cold turn -> $0.032 on the next turn (~94% prefix hit).
# Requires the pi-ai patch (patches/, applied by patch-package on install) and
# self-disables unless the active provider is OpenRouter, so the marker can
# never reach a provider that would not strip it.
# CHAT_CACHE_SPLIT=0

# REQUIRED for BYOK (Settings > API Keys): AES-256-GCM key for encrypting
# founder-stored API keys at rest. 32 bytes — 64-char hex (openssl rand -hex 32)
# or 44-char base64. Saving a key THROWS without it, so the shipped settings
# feature is broken on any site missing this var (that was prod's state until
# 2026-09-01). IMPORTANT: dev, staging, and prod share ONE Supabase database,
# so every environment must use the SAME key or keys saved in one environment
# cannot be decrypted in another.
# ENCRYPTION_KEY=

# Optional: Langfuse LLM Observability
LANGFUSE_PUBLIC_KEY=pk-...
LANGFUSE_SECRET_KEY=sk-...
LANGFUSE_BASE_URL=https://cloud.langfuse.com
# Optional: explicit environment tag for Langfuse traces (production/staging/
# development). Dev, staging, and prod all point at the SAME Langfuse project,
# so without this, non-prod test traces are indistinguishable from real founder
# traffic. Falls back to Netlify's CONTEXT, then NODE_ENV, when unset.
LANGFUSE_ENVIRONMENT=development

# Optional: Jina API key for web_search + read_url tools (src/lib/pi-tools.ts).
# Without a key, both tools fall back to higher-latency / rate-limited
# unauthenticated Jina calls. On Jina errors, tools fall back to
# DuckDuckGo HTML scraping + raw fetch (same output shape).
# Free tier: https://jina.ai — 1M tokens/month free with key.
# JINA_API_KEY=jina_...

# Supabase Auth (required for login)
# Create a project at https://supabase.com, enable "Email" provider with magic link,
# then paste the keys from Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Supabase PostgreSQL — required for all data persistence.
# Use the connection pooler URL from Supabase: Settings → Database → Connection string → URI (pooler).
# Format: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres.your-project-ref:your-password@aws-0-us-east-1.pooler.supabase.com:6543/postgres
# Only needed for server-side admin operations (we don't use it today; reserved for later):
# SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Dev-only: which email the backfill script attaches existing projects to.
DEV_USER_EMAIL=dev@launchpad.local

# Monday Brief email (optional). When unset, src/lib/email.ts runs in stub
# mode — sendBrief() logs "would have emailed X" without making a network
# call. To flip to real delivery:
#   1. Sign up at resend.com (free tier: 100 emails/day, 3k/month)
#   2. Verify your sender domain
#   3. Uncomment + set both keys below
# RESEND_API_KEY=re_...
#
# Supabase Auth Hook — Send Email (optional). When set, the
# /api/auth/hook/send-email endpoint verifies HMAC signatures from
# Supabase and sends branded, locale-aware magic-link emails via Resend.
# Configure the hook in Supabase Dashboard → Auth → Hooks → Send Email.
# Generate secret: openssl rand -hex 32
# SUPABASE_AUTH_HOOK_SECRET=your_long_random_hex_string
# SENSEFOUND_MAIL_FROM=brief@sensefound.io     # preferred (falls back to LAUNCHPAD_MAIL_FROM)
# SENSEFOUND_APP_URL=https://app.sensefound.io  # preferred (falls back to LAUNCHPAD_APP_URL)
# LAUNCHPAD_MAIL_FROM=launchpad@yourdomain.com  # legacy fallback
# LAUNCHPAD_APP_URL=https://your-site.netlify.app  # legacy fallback

# Optional: Firecrawl API for URL-based change detection (src/lib/firecrawl.ts).
# When set, watch sources use Firecrawl's native change tracking with git-diff.
# When unset, falls back to Jina scraping + SHA256 hash comparison (no diff).
# Free tier: 500 credits/month (~15 daily sources). Growth: $19/mo for 3,000 credits.
# Sign up: https://firecrawl.dev
# FIRECRAWL_API_KEY=fc-...
# FIRECRAWL_API_URL=https://api.firecrawl.dev  # default, only override for self-hosted

# Cron auth — shared secret required by /api/cron (GET + POST).
# The GitHub Actions scheduled-cron.yml workflow sends
# Authorization: Bearer ${CRON_SECRET}. Manual curl needs the same header.
# When unset, the endpoint is open (dev-friendly default). In production,
# ALWAYS set this — every cron tick can fan out to N monitors * project
# count * Sonnet cost, so an unauthenticated pinger becomes a cost-amp.
# Generate with: openssl rand -hex 32
# CRON_SECRET=your_long_random_hex_string

# Which UTC weekday the cron's weekly pulse fires (HEARTBEAT reflection +
# cross-signal correlation + Monday Brief). 0=Sun … 6=Sat. Default Monday (1).
# WEEKLY_PULSE_DAY=1
